# ---------------------------------------------------------------------------
# EmailJS — powers the contact form at /contact
#
# Get these three values from https://dashboard.emailjs.com
#   1. Email Services  -> add a service connected to info@testportalva.org
#                         (or olufemi.adebayo@testportalva.org)  -> copy Service ID
#   2. Email Templates -> create a template  -> copy Template ID
#   3. Account -> General -> copy the Public Key
#
# Copy this file to `.env.local` and paste the real values in.
# `.env.local` is gitignored and must never be committed.
#
# NOTE: these are NEXT_PUBLIC_ variables, so they are visible in the browser
# bundle. That is how EmailJS is designed to work. Protect your quota by
# locking the allowed domain to testportalva.org in the EmailJS dashboard
# (Account -> Security -> Allowed Domains).
# ---------------------------------------------------------------------------

NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
